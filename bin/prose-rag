#!/usr/bin/env bash
# bin/prose-rag -- STABLE consumer entrypoint (SPEC-184), an ADAPTER since SPEC-250.
# context-kit owns the engine; `cargo install --path src/prose-rag` in a context-kit
# checkout puts the binary on PATH. This shim only RESOLVES it, in the order
# `config seams` reports for the PROSE_RAG_BIN row: $PROSE_RAG_BIN (a regular
# executable file), then `prose-rag` on PATH. It never builds and never looks
# under lib/.
# `hook` with no engine exits 0: a recall hook must never break a prompt.
set -euo pipefail

# A consumer may put THIS shim on PATH as `prose-rag`; the lookup below would then
# exec it forever. The marker survives exec, so a second entry skips resolution and
# falls through to the no-engine contract instead of recursing.
if [ -z "${PROSE_RAG_SHIM_ACTIVE:-}" ]; then
  export PROSE_RAG_SHIM_ACTIVE=1
  bin="${PROSE_RAG_BIN:-}"
  # [ -x ] alone is true for a searchable directory; a binary must be a regular file too.
  if [ -n "$bin" ] && [ -f "$bin" ] && [ -x "$bin" ]; then
    exec "$bin" "$@"
  fi
  if bin="$(command -v prose-rag 2>/dev/null)" && [ -n "$bin" ]; then
    exec "$bin" "$@"
  fi
fi

[ "${1:-}" = "hook" ] && exit 0
# `index` with no corpus configured = an unconfigured consumer (the shipped
# kit-weekly job): skip clean, same contract as the engine's own guard. An
# explicit --corpus means someone is driving interactively -> honest error.
if [ "${1:-}" = "index" ] && [ -z "${PROSE_RAG_CORPUS:-}" ] && [[ "$*" != *"--corpus"* ]]; then
  echo "prose-rag: no corpus configured (set PROSE_RAG_CORPUS or pass --corpus); nothing indexed"
  exit 0
fi
echo "prose-rag: engine not installed; install context-kit's binary: cargo install --path <context-kit>/src/prose-rag (or set PROSE_RAG_BIN)" >&2
exit 1
